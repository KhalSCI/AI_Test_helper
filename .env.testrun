# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Model slots (toggled with Ctrl+Shift+M). Override if OpenRouter renames them.
MODEL_OPUS=anthropic/claude-opus-4.8
MODEL_SONNET=anthropic/claude-sonnet-4.6

# Extended reasoning budget (tokens). Set to 0 to disable thinking.
REASONING_TOKENS=5000

# Max output tokens
MAX_TOKENS=8000
